# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://username:password@localhost:5432/emonoshots?schema=public"

# ── Auth ───────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"

# ── Google OAuth ───────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Sanity CMS ─────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID="your-sanity-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-01-01"
SANITY_API_TOKEN="your-sanity-api-token"

# ── Anthropic AI ───────────────────────────────────────────
ANTHROPIC_API_KEY="your-anthropic-api-key"

# ── Stripe ─────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ── Cloudinary (image hosting fallback) ───────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ── App ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://emonoshots.ma"
NEXT_PUBLIC_BRAND_NAME="EMONOSHOTS"
NEXT_PUBLIC_PHOTOGRAPHER_EMAIL="contact@emonoshots.ma"
NEXT_PUBLIC_LOCATION="Casablanca, Morocco"
